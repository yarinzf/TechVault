# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example
!.env.docker.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads / Generated files
uploads/
coverage/
dist/
.tmp/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.claude/

# Docker
docker-data/

# Terraform — never commit real state or variable values
devops/terraform/.terraform/
devops/terraform/.terraform.lock.hcl
devops/terraform/terraform.tfstate
devops/terraform/terraform.tfstate.backup
devops/terraform/tfplan
devops/terraform/*.tfvars
!devops/terraform/*.tfvars.example

# Terraform — DevOps assignment environment (separate from production above)
devops/terraform-assignment/.terraform/
devops/terraform-assignment/.terraform.lock.hcl
devops/terraform-assignment/terraform.tfstate
devops/terraform-assignment/terraform.tfstate.backup
devops/terraform-assignment/tfplan
devops/terraform-assignment/*.tfvars
!devops/terraform-assignment/*.tfvars.example

# Terraform state files (extra safety, covers both directories above)
*.tfstate
*.tfstate.*
.terraform/

# Ansible — never commit real inventory or vault passwords
devops/ansible/inventory.ini
devops/ansible/.vault_password

# Ansible — DevOps assignment environment
devops/ansible-assignment/inventory.ini
devops/ansible-assignment/.vault_password

# SSH private keys — never commit, production or assignment
*.pem

# Backups — never commit database dumps
backups/
*.dump
*.dump.gz
devops/scripts/*.log