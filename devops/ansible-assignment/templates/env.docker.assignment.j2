# ── TechVault Docker environment — DevOps ASSIGNMENT ({{ environment_name }}) ──
# Generated by devops/ansible-assignment/deploy.yml — do not edit by hand on
# the server; re-run the playbook instead. This file is separate from, and
# never overwrites, production's /opt/techvault/.env.docker.

NODE_ENV=production
PORT=5000
API_VERSION=v1

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET={{ jwt_access_secret }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret }}
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECRET={{ cookie_secret }}
{% if app_domain %}
COOKIE_DOMAIN=.{{ app_domain }}
{% endif %}

# ── CORS / URLs — derived from app_domain / ansible_host, never hardcoded ────
ALLOWED_ORIGINS={{ allowed_origins }}
FRONTEND_URL={{ frontend_url }}

# ── Tax ───────────────────────────────────────────────────────────────────────
TAX_RATE=0.17

# ── Email (optional — leave blank to disable transactional email) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@techvault.com

# ── Stripe (stub keeps the app running without a real Stripe account) ───────
STRIPE_SECRET_KEY={{ stripe_secret_key | default('sk_test_stub') }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret | default('whsec_stub') }}

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID={{ google_client_id | default('') }}

# ── Frontend build args ───────────────────────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY={{ vite_stripe_public_key | default('pk_test_stub') }}
VITE_GOOGLE_CLIENT_ID={{ vite_google_client_id | default('') }}

# ── Backups (optional — leave blank to disable S3 offsite sync) ─────────────
S3_BACKUP_BUCKET={{ s3_backup_bucket | default('') }}
