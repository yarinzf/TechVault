# TechVault Jenkins host ({{ environment_name }}) — host-level Nginx reverse proxy
# Generated by devops/ansible-jenkins/provision.yml — do not hand-edit; re-run
# the playbook instead.
#
# HTTP-only, always, by design — same architecture decision as
# devops/ansible-assignment/templates/nginx-assignment.conf.j2: this template
# has no HTTPS/TLS branch, so it never references a certificate path and can
# never fail to start because a cert doesn't exist yet. Adding HTTPS is a
# deliberate, separate, manual step performed later — see
# devops/ansible-jenkins/README.md "HTTPS architecture decision".

server {
    listen 80 default_server;
    server_name {{ jenkins_domain if jenkins_domain else '_' }};

    client_max_body_size 50m;

    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options nosniff always;

    # Reserved for a future manual Certbot HTTP-01 challenge (webroot mode).
    # Inert until you actually run Certbot by hand — see README.md.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Root-path proxy: no path segment after the port in proxy_pass, and no
    # trailing slash, so nginx forwards the original request URI unchanged.
    # This is deliberate and is the simplest correct form for a root-mounted
    # Jenkins (no --prefix=/jenkins on the Jenkins side, no path rewriting
    # needed here) — the trailing-slash-strips-the-location-prefix behavior
    # that trips people up with sub-path proxying doesn't come into play when
    # the location itself is "/".
    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Jenkins needs its real external URL reflected back accurately —
        # both for its own redirects and for the "Jenkins URL" setting under
        # Manage Jenkins → System — hence the full X-Forwarded-* set,
        # including the port (Jenkins' own reverse-proxy documentation calls
        # this out explicitly for correct root-URL reconstruction).
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Port  $server_port;

        # WebSocket/Upgrade support — Jenkins uses this for the CLI over
        # HTTP and some agent/UI features.
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";

        # Matches Jenkins' own documented Nginx reference configuration:
        # avoid buffering so streaming build console output and large
        # request bodies (plugin uploads, artifact fetches) aren't held
        # entirely in memory before being forwarded either direction.
        proxy_request_buffering off;
        proxy_buffering         off;

        # Jenkins can be slow to respond during heavy build/agent activity;
        # avoid the reverse proxy timing out sessions prematurely.
        proxy_connect_timeout 90s;
        proxy_read_timeout    90s;
        proxy_send_timeout    90s;

        # Currently a no-op (rewrites "http://" to "http://" while HTTP-only)
        # — kept because it's Jenkins' own documented reference setting, and
        # it becomes meaningful automatically once HTTPS is added later
        # (rewrites any hardcoded http:// redirect from the backend to
        # https://), with no code change needed at that point.
        proxy_redirect      http:// $scheme://;
    }
}
